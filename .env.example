# Vanguard Fashion — environment configuration
#
# The app reads its configuration from --dart-define values at build/run time
# (see lib/core/utils/env.dart). Copy the values below into your run command:
#
#   flutter run -d chrome \
#     --dart-define=SUPABASE_URL=https://YOUR_PROJECT.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
#
# For CI / production builds, pass the same defines to `flutter build web`.
# NEVER commit real keys — the publishable (anon) key is safe in the client
# bundle, but keep service-role keys server-side only (Edge Functions).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# ---------------------------------------------------------------------------
# Optional: shipping display fallbacks
# ---------------------------------------------------------------------------
# These are only used before the app has talked to the backend, and when running
# without Supabase at all. Once connected, the live figures come from the
# `store_settings` table — which is also what `place_order` charges, so these
# values can never disagree with the amount a shopper actually pays.
#
# Dart has no `double.fromEnvironment` (only String/int/bool), so these are
# declared as strings and parsed at startup.
#
#   --dart-define=FLAT_SHIPPING_FEE=12.0
#   --dart-define=FREE_SHIPPING_THRESHOLD=150.0

FLAT_SHIPPING_FEE=12.0
FREE_SHIPPING_THRESHOLD=150.0

# ---------------------------------------------------------------------------
# Edge Function config (set with `supabase secrets set`, not in the app bundle)
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the validate-promo function. Leave
# unset for local development, where it falls back to `*`.
#
#   ALLOWED_ORIGINS=https://vanguard.fashion,https://www.vanguard.fashion
