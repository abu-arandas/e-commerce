# Vanguard Fashion — environment configuration
#
# The app reads Supabase credentials from --dart-define values at build/run time
# (see lib/core/utils/env.dart). Copy the values below into your run command:
#
#   flutter run -d chrome \
#     --dart-define=SUPABASE_URL=https://YOUR_PROJECT.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
#
# For CI / production builds, pass the same defines to `flutter build web`.
# NEVER commit real keys — the anon key is publishable, but keep service-role
# keys server-side only (Edge Functions), never in the Flutter bundle.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
